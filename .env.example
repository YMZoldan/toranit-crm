# ---- domain & Traefik (match the names in your Traefik setup) ----
DOMAIN=cameras.toranit.co.il
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ---- secrets: generate each with  openssl rand -hex 32 ----
POSTGRES_PASSWORD=CHANGE_ME
SESSION_SECRET=CHANGE_ME

# ---- first login user (created only when there are no users yet) ----
ADMIN_EMAIL=you@toranit.co.il
ADMIN_PASSWORD=CHANGE_ME

# keep true behind HTTPS
COOKIE_SECURE=true
